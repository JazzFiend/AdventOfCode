cabal-version:  3.0
name:           aoc2025
version:        0.1.0.0
build-type:     Simple

library
  hs-source-dirs:   src
  default-language: Haskell2010
  build-depends:    base ^>=4.18
  exposed-modules:
      Day01
      Day01SecretEntrance.CombinationLock

executable aoc2025
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: Haskell2010
  build-depends:
      base ^>=4.18
    , aoc2025

test-suite aoc2025-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  default-language: Haskell2010
  build-depends:
      base ^>=4.18
    , hspec ^>=2.11
    , QuickCheck ^>=2.14
    , aoc2025
  build-tool-depends:
      hspec-discover:hspec-discover ^>=2.11
  other-modules:
      Day01SecretEntrance.CombinationLockSpec